{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@commands/*": ["src/commands/*"],
      "@config/*": ["src/config/*"],
      "@core/*": ["src/core/*"],
      "@database/*": ["src/database/*"],
      "@harness/*": ["src/harness/*"],
      "@input/*": ["src/input/*"],
      "@layout/*": ["src/layout/*"],
      "@session/*": ["src/session/*"],
      "@theme/*": ["src/theme/*"],
      "@widgets/*": ["src/widgets/*"]
    }
  },
  "include": ["src"],
  "exclude": ["**/.claude/**", "node_modules"]
}
